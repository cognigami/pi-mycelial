{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "pi-extension-kit/*": ["../pi-extension-kit/src/*.ts"]
    },
    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts"]
}
