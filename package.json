    }
  },
  "dependencies": {
    "ulid": "^3.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "bun-types": "^1.3.14",
    "pi-extension-kit": "file:../pi-extension-kit",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2"
